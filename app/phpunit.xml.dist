<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="src/Modules/Wallet/Tests/Support/bootstrap.php"
         defaultTestSuite="Wallet Unit"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Wallet Unit">
            <directory>src/Modules/Wallet/Tests/Unit</directory>
        </testsuite>
        <testsuite name="Wallet Integration">
            <directory>src/Modules/Wallet/Tests/Integration</directory>
        </testsuite>
        <testsuite name="Wallet Concurrency">
            <directory>src/Modules/Wallet/Tests/Concurrency</directory>
        </testsuite>
    </testsuites>
</phpunit>

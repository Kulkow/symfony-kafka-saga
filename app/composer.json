{
    "name": "app/symfony-kafka-saga",
    "description": "DDD modular monolith for learning Kafka and sagas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_pgsql": "*",
        "ext-rdkafka": "^6.0",
        "ext-redis": "*",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.6",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "config": {
        "allow-plugins": {"symfony/runtime": true},
        "sort-packages": true
    },
    "scripts": {
        "test": ["@php tests/run.php", "@php vendor/bin/phpunit --testsuite \"Wallet Unit\""],
        "test:wallet": "@php vendor/bin/phpunit --testsuite \"Wallet Unit\"",
        "test:database:prepare": "@php bin/console test:database:prepare --env=test --no-debug",
        "test:wallet:setup": "@test:database:prepare",
        "test:wallet:integration": "@php vendor/bin/phpunit --testsuite \"Wallet Integration\"",
        "test:wallet:concurrency": "@php vendor/bin/phpunit --testsuite \"Wallet Concurrency\"",
        "check": [
            "@php bin/console lint:yaml config",
            "@php bin/console lint:container",
            "@php bin/console doctrine:schema:validate --skip-sync",
            "@php bin/console cache:warmup"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/process": "8.1.*"
    }
}
